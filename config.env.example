# OpenWhatsappBot configuration: copy this file to config.env and fill in what you need.
#
# Nearly every setting can also be changed from the admin panel (Settings page), which takes priority over
# this file. The file stays the starting point: its values apply until the panel overrides them. The settings
# of the "Admin panel", "Logging" and "Updates" blocks are read at start-up only; the panel shows them read-only.
#
# Lines starting with "#" followed directly by a name (for example "#PANEL_PORT=3000") are settings that are
# off by default: remove the "#" to use them. An empty value is the same as an unset one.

# Bot Configuration
PREFIX=.
# Owner numbers, comma separated, digits with the country code (33612345678,237650000000).
# Empty = nobody can use the owner commands
SUDO=

# Language & Locale
BOT_LANG=fr
TIMEZONE=UTC

# Bot Behavior
ALWAYS_ONLINE=false
AUTO_STATUS_VIEW=true
AUTO_STATUS_REACT=false
# Emojis used to react to statuses, comma separated
STATUS_EMOJIS=😀,👍,❤️,🔥,💯,✨,🎉,👏,💪,🙌
# Forward the statuses of chosen contacts to the owners. These two only seed data/status_save.json the first
# time it is created; afterwards use the .statussave command or the panel. AUTO_STATUS_SAVE=true forces it on
AUTO_STATUS_SAVE=false
STATUS_SAVE_LIST=
ENABLE_MESSAGE_REACTIONS=true

# Sticker Configuration
STICKER_PACKNAME=Made with
# The code default is "Bot"; this suggested value is kept for existing installations
STICKER_AUTHOR=Levanter Bot

# API Keys (the panel can store them encrypted and test them; the values here are used until it does)
OPENAI_API_KEY=
GEMINI_API_KEY=
WEATHER_API_KEY=
UNSPLASH_API_KEY=
GIPHY_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Reddit app credentials (https://www.reddit.com/prefs/apps, type "script"), required by the reddit command
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# AI models
# Gemini text model (gemini, auto responder)
GEMINI_MODEL=gemini-2.5-flash
# Gemini model for image analysis (empty = same as GEMINI_MODEL)
GEMINI_VISION_MODEL=
# Model used by the image generation command (empty = the plugin's default)
IMAGE_MODEL=
# OpenAI chat model used by the gpt command
OPENAI_MODEL=gpt-4o-mini

# Optional social download backend, used only as a fallback after yt-dlp (empty = disabled)
BACKEND_URL=

# Media downloads (yt-dlp must be installed; the Docker image includes it)
# Path or name of the yt-dlp binary (start-up setting: the panel does not edit an executable path)
YTDLP_PATH=yt-dlp
# Maximum duration of a download, in milliseconds
DOWNLOAD_TIMEOUT=180000

# Database (Leave empty for SQLite, or use PostgreSQL URL)
DATABASE_URL=
# Set to false for a Postgres server without SSL (e.g. internal Dokploy database)
DATABASE_SSL=true

# Logging
LOG_LEVEL=info
BAILEYS_LOG_LVL=silent
# pretty (readable, default) or json (one object per line, for log collectors)
LOG_FORMAT=pretty

# Group Settings
ANTILINK_MSG=_Antilink Detected &mention kicked_
ANTIBOT_MSG=&mention removed
WARN_LIMIT=3
# Quote values containing \n so that it becomes a line break
WARN_MESSAGE="⚠️WARNING⚠️\n*User:* &mention\n*Warn:* &warn\n*Remaining:* &remaining"
WARN_KICK_MESSAGE="&mention kicked"

# Limits
# Largest file the bot downloads, sends or accepts from the panel, in MB
MAX_UPLOAD=230
# Longest text accepted by the tts and voice commands, in characters
TTS_MAX_LENGTH=500
# Messages processed at the same time
MESSAGE_CONCURRENCY_LIMIT=5

# Auto Responder (Gemini AI)
# The enabled switch, the ignored numbers and the personality only seed the database the first time; afterwards
# use the .ar command or the panel
AUTO_RESPONDER_ENABLED=false
AUTO_RESPONDER_IGNORE_NUMBERS=
AUTO_RESPONDER_PERSONALITY=You are a helpful and friendly assistant. Respond naturally and conversationally.

# Anti-ban measures for auto responder
AUTO_RESPONDER_MIN_DELAY=1000
AUTO_RESPONDER_MAX_DELAY=3000
AUTO_RESPONDER_TYPING_SPEED=50
AUTO_RESPONDER_MAX_TYPING_TIME=10000
AUTO_RESPONDER_RATE_LIMIT=5
AUTO_RESPONDER_RATE_WINDOW=60000

# Internal tuning (milliseconds unless noted; the defaults suit most installations)
# Anti-delete cache: sweep interval and how long a message is kept
CACHE_CLEANUP_INTERVAL=600000
CACHE_MAX_AGE=3600000
# AI conversation history: save interval and messages written per batch
CONVERSATION_UPDATE_INTERVAL=2000
CONVERSATION_BATCH_SIZE=5
# Memory manager: cleanup interval, and the heap size (MB) above which it cleans more aggressively
MEMORY_CLEANUP_INTERVAL=900000
MEMORY_WARN_THRESHOLD=400

# Admin panel (web interface, http://localhost:3000/admin/)
# On by default. At the first start the console prints a one-time setup link (valid 30 minutes) where you choose
# the administrator password; nothing else is needed. Only the exact value false turns the panel off (the bot keeps
# running).
ADMIN_PANEL=true
# Address and port. Leave them unset: the panel listens on 127.0.0.1 on a normal machine and on 0.0.0.0 inside a
# container or on a hosting panel that sets PORT. The PORT and HOST variables of such hosts are accepted as aliases
# (order for the port: PANEL_PORT, PORT, 3000). Keep the panel off the Internet or put HTTPS in front of it
#PANEL_HOST=
#PANEL_PORT=3000
# Public address of the panel (an origin, no path), for example https://bot.example.com. Used for the setup link
# and accepted as the Origin of panel requests when the panel is reached through a reverse proxy
PANEL_PUBLIC_URL=
# Reverse proxy in front of the panel: IP addresses, CIDR ranges or the keywords loopback, private, all, comma
# separated. Forwarded headers (X-Forwarded-For/-Proto/-Host) are honoured only from these peers, never
# automatically. Empty = not trusted
PANEL_TRUST_PROXY=
# Interval of the panel's keep-alive timer, in milliseconds
KEEP_ALIVE_INTERVAL=60000
# Secret for POST /api/restart (sent as "Authorization: Bearer <token>").
# Leave empty to disable the endpoint (it then answers 403). Use a long random value.
PANEL_TOKEN=

# Updates
# Who restarts the bot after an update: auto (detect PM2, a hosting panel...), true or false
SUPERVISED=auto
# Check for a newer version in the background (the panel and an owner alert announce it). false = never check
UPDATE_CHECK=true

# No effect in this version
# Nothing reads the settings below today. They are kept so that an existing config.env stays valid and the panel
# lists them (read-only, in its "no effect" group); they will be removed or revived in a later release.
# Legacy session string: the multi-file login in sessions/main replaced it
SESSION_ID=
# Not read by any code: only statuses are viewed automatically (AUTO_STATUS_VIEW)
AUTO_READ=true
# Statuses are forwarded to the owners, not stored in a folder
STATUS_SAVE_FOLDER=media/status
# The real feature is the .antidel command (or the panel)
ANTI_DELETE=false
VPS=true
# Keys of services no command uses any more
GROQ_API_KEY=
RMBG_KEY=
CLOUDMERSIVE_API_KEY=
APYHUB_API_KEY=
DEEPAI_API_KEY=
WAIFUPICS_API_KEY=
PUTERJS_API_KEY=
IMAGE_API_TIMEOUT=20000
IMAGE_API_MAX_SIZE_MB=10
# Deployment leftovers (Heroku, Koyeb, Render)
HEROKU_APP_NAME=
HEROKU_API_KEY=
KOYEB=false
KOYEB_NAME=
KOYEB_API=
RENDER_NAME=
RENDER_API_KEY=
