{
  "name": "open-whatsapp-bot",
  "version": "61.2.0",
  "description": "Open Source Community WhatsApp Bot with Baileys",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start . --attach --name open-whatsapp-bot",
    "dev": "node index.js",
    "docker": "pm2-runtime start . --name open-whatsapp-bot",
    "stop": "pm2 stop open-whatsapp-bot",
    "panel": "node panel.js",
    "panel:pm2": "pm2 start panel.js --attach --name open-whatsapp-bot-panel",
    "test": "node --test --test-force-exit \"test/**/*.test.js\""
  },
  "author": "Landry Simo",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hapi/boom": "^10.0.1",
    "@ryuu-reinzz/button-helper": "2.2.3",
    "@vitalets/google-translate-api": "^9.2.1",
    "axios": "^1.20.0",
    "baileys": "7.0.0-rc14",
    "dotenv": "^18.0.9",
    "file-type": "^22.2.0",
    "google-tts-api": "^2.0.2",
    "html-entities": "^2.6.0",
    "luxon": "^3.7.2",
    "node-webpmux": "^3.2.1",
    "openai": "^7.45.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pm2": "^7.1.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "simple-git": "^4.0.2",
    "sqlite3": "^6.0.1"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
