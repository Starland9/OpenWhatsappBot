{
  "name": "open-whatsapp-bot",
  "version": "61.2.0",
  "description": "Open Source Community WhatsApp Bot with Baileys",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start . --attach --name open-whatsapp-bot",
    "dev": "node index.js",
    "docker": "pm2-runtime start . --name open-whatsapp-bot",
    "stop": "pm2 stop open-whatsapp-bot",
    "panel": "node panel.js",
    "panel:pm2": "pm2 start panel.js --attach --name open-whatsapp-bot-panel",
    "postinstall": "node -e \"try { require('sharp') } catch (e) { process.exit(1); }\" || yarn add sharp@0.33.5"
  },
  "author": "Landry Simo",
  "license": "MIT",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.8.0",
    "@google/generative-ai": "^0.24.1",
    "@hapi/boom": "^10.0.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "audio-decode": "^2.1.3",
    "axios": "^1.18.0",
    "baileys": "^7.0.0-rc13",
    "browser-id3-writer": "^6.3.1",
    "cheerio": "^1.2.0",
    "cookie": "^1.1.1",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "fastq": "^1.20.1",
    "file-type": "^22.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "fs-extra": "^11.3.5",
    "google-tts-api": "^2.0.2",
    "googleapis": "^173.0.0",
    "heroku-client": "^3.1.2",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.1",
    "openai": "^6.42.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "play-dl": "^1.9.7",
    "pm2": "^7.0.1",
    "qrcode": "^1.5.4",
    "qrcode-reader": "^1.0.4",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.1",
    "simple-git": "^3.36.0",
    "sqlite3": "^6.0.1",
    "translate-google-api": "^1.0.4",
    "youtubei.js": "^17.0.1"
  },
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
